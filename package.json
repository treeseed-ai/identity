{
  "name": "@treeseed/identity",
  "version": "0.1.0-rc.14",
  "description": "Independent TreeSeed identity and session integration adapters.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/treeseed-ai/identity.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.tests.json && node --experimental-strip-types --test tests/*.test.mjs tests/*.test.ts",
    "verify": "npm run build && npm test",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@treeseed/sdk": "0.13.0-rc.107",
    "jose": "6.2.12",
    "oauth4webapi": "3.8.8"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
