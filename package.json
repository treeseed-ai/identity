  "cordisService": {
    "role": "identity",
    "service": {
      "command": [
        "start",
        "--import-realm"
      ],
      "environment": {
        "JAVA_OPTS_KC_HEAP": "-Xms128m -Xmx512m"
      },
      "user": "installation-owner",
      "workerSocket": false,
      "volumes": [],
      "secrets": [
        {
          "source": "identity-config",
          "target": "/opt/keycloak/conf/keycloak.conf"
        },
        {
          "source": "identity-realm",
          "target": "/opt/keycloak/data/import/cordis-realm.json"
        }
      ],
      "portTarget": null
    },
    "slots": {
      "oidc-client": {
        "kind": "random"
      },
      "bootstrap-password": {
        "kind": "random"
      },
      "bootstrap-subject": {
        "kind": "uuid"
      },
      "identity-config": {
        "kind": "properties",
        "value": {
          "db": "postgres",
          "db-url": "jdbc:postgresql://database:5432/cordis",
          "db-username": "cordis",
          "db-password": {
            "$secret": "database-password"
          },
          "http-enabled": "true",
          "http-relative-path": "/identity",
          "hostname": {
            "$origin": "/identity"
          },
          "proxy-headers": "xforwarded",
          "health-enabled": "true"
        }
      },
      "identity-realm": {
        "kind": "json",
        "value": {
          "realm": "cordis",
          "enabled": true,
          "sslRequired": "external",
          "registrationAllowed": false,
          "loginWithEmailAllowed": false,
          "resetPasswordAllowed": false,
          "clients": [
            {
              "clientId": "cordis-admin",
              "enabled": true,
              "protocol": "openid-connect",
              "publicClient": false,
              "secret": {
                "$secret": "oidc-client"
              },
              "standardFlowEnabled": true,
              "directAccessGrantsEnabled": false,
              "redirectUris": [
                {
                  "$origin": "/admin/callback"
                }
              ],
              "attributes": {
                "pkce.code.challenge.method": "S256"
              }
            }
          ],
          "users": [
            {
              "id": {
                "$secret": "bootstrap-subject"
              },
              "username": "admin",
              "enabled": true,
              "emailVerified": true,
              "email": "admin@localhost",
              "firstName": "Installation",
              "lastName": "Owner",
              "requiredActions": [],
              "credentials": [
                {
                  "type": "password",
                  "value": {
                    "$secret": "bootstrap-password"
                  },
                  "temporary": false
                }
              ]
            }
          ]
        }
      },
      "bootstrap": {
        "kind": "json",
        "value": {
          "username": "admin",
          "password": {
            "$secret": "bootstrap-password"
          }
        }
      }
    },
    "readiness": {
      "kind": "http-json",
      "path": "/identity/realms/cordis/.well-known/openid-configuration",
      "expected": {
        "issuer": {
          "$origin": "/identity/realms/cordis"
        }
      }
    }
  },
